# FastAPI Backend Environment Variables
#
# NOTE:
# - Do not commit real secrets.
# - The orchestrator will populate the actual .env in each environment.

# ---- App mode ----
# development | preview | production
APP_ENV=preview

# ---- CORS ----
# Comma-separated allowed origins for browser clients (Next.js preview runs on a different origin).
# Example:
# CORS_ALLOW_ORIGINS=https://vscode-internal-...:3000,http://localhost:3000
CORS_ALLOW_ORIGINS=*

# ---- Auth ----
# REQUIRED: secret used to sign JWTs (HS256)
JWT_SECRET=
# Optional: defaults to 60
JWT_EXPIRES_MINUTES=60

# ---- Database (Postgres) ----
# Preferred: provide full SQLAlchemy DB URL:
# POSTGRES_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=

# Or provide components (used if POSTGRES_URL is empty):
POSTGRES_HOST=localhost
# Default backend assumes the included DB container uses port 5000.
POSTGRES_PORT=5000
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
